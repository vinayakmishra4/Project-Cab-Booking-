odal${wide ? \" wide\" : \"\"}`} role=\"dialog\" aria-modal=\"true\" aria-label={title}>\n                <header className=\"admin-modal-header\">\n                    <h2>{title}</h2>\n                    <button type=\"button\" className=\"admin-icon-button\" onClick={onClose} aria-label=\"Close dialog\">×</button>\n                </header>\n                {children}\n            </section>\n        </div>\n    );\n}\n\nexport default AdminModal;\n"],"mappings":"AAAA,OAASA,SAAS,KAAQ,OAAO,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAElC,QAAS,CAAAC,UAAUA,CAAC,CAAEC,KAAK,CAAEC,OAAO,CAAEC,QAAQ,CAAEC,IAAI,CAAG,KAAM,CAAC,CAAE,CAC5DT,SAAS,CAAC,IAAM,CACZ,KAAM,CAAAU,aAAa,CAAIC,KAAK,EAAK,CAC7B,GAAIA,KAAK,CAACC,GAAG,GAAK,QAAQ,CAAEL,OAAO,CAAC,CAAC,CACzC,CAAC,CACDM,MAAM,CAACC,gBAAgB,CAAC,SAAS,CAAEJ,aAAa,CAAC,CACjD,MAAO,IAAMG,MAAM,CAACE,mBAAmB,CAAC,SAAS,CAAEL,aAAa,CAAC,CACrE,CAAC,CAAE,CAACH,OAAO,CAAC,CAAC,CAEb,mBACIL,IAAA,QAAKc,SAAS,CAAC,sBAAsB,CAACC,WAAW,CAAGN,KAAK,EAAK,CAC1D,GAAIA,KAAK,CAACO,MAAM,GAAKP,KAAK,CAACQ,aAAa,CAAEZ,OAAO,CAAC,CAAC,CACvD,CAAE,CAAAC,QAAA,cACEJ,KAAA,YAASY,SAAS,CAAE,cAAcP,IAAI,CAAG,OAAO,CAAG,EAAE,EAAG,CAACW,IAAI,CAAC,QAAQ,CAAC,aAAW,MAAM,CAAC,aAAYd,KAAM,CAAAE,QAAA,eACvGJ,KAAA,WAAQY,SAAS,CAAC,oBAAoB,CAAAR,QAAA,eAClCN,IAAA,OAAAM,QAAA,CAAKF,KAAK,CAAK,CAAC,cAChBJ,IAAA,WAAQmB,IAAI,CAAC,QAAQ,CAACL,SAAS,CAAC,mBAAmB,CAACM,OAAO,CAAEf,OAAQ,CAAC,aAAW,cAAc,CAAAC,QAAA,CAAC,MAAC,CAAQ,CAAC,EACtG,CAAC,CACRA,QAAQ,EACJ,CAAC,CACT,CAAC,CAEd,CAEA,cAAe,CAAAH,UAAU","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}